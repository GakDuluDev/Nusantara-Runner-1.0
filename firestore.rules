rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll([
          'uid', 'displayName', 'highScore', 'bestDistance',
          'correctAnswers', 'levelReached', 'isAnonymous', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'highScore', 'bestDistance',
          'correctAnswers', 'levelReached', 'isAnonymous', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 32
        && data.highScore is int
        && data.highScore >= 0
        && data.highScore <= 10000000
        && data.bestDistance is int
        && data.bestDistance >= 0
        && data.bestDistance <= 1000000
        && data.correctAnswers is int
        && data.correctAnswers >= 0
        && data.correctAnswers <= 10000
        && data.levelReached is int
        && data.levelReached >= 1
        && data.levelReached <= 3
        && data.isAnonymous is bool
        && data.updatedAt is timestamp;
    }

    match /leaderboard/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn() && resource.data.highScore >= 0;

      allow create: if isSignedIn()
        && isValidId(userId)
        && userId == request.auth.uid
        && isValidLeaderboardEntry(incoming())
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(userId)
        && userId == request.auth.uid
        && isValidLeaderboardEntry(incoming())
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && (
          // Action 1: Update Display Name only in Lobby
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt'])
          ||
          // Action 2: Update High Score & Run Stats (monotonic highScore)
          (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'highScore', 'bestDistance',
              'correctAnswers', 'levelReached', 'isAnonymous', 'updatedAt'
            ])
            && incoming().highScore >= existing().highScore
          )
        );

      allow delete: if false;
    }
  }
}
